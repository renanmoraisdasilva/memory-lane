{
  "name": "memory-lane",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, read-only archive catalog for Windows",
  "author": "Renan Silva",
  "license": "MIT",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run rebuild:electron && npm run build && electron-builder",
    "package:win": "npm run rebuild:electron && npm run build && electron-builder --win nsis portable",
    "package:unpacked": "npm run rebuild:electron && npm run build && electron-builder --win dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:read-only": "node scripts/check-read-only.mjs",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "npm run rebuild:node && vitest run",
    "test:unit": "npm run rebuild:node && vitest run src",
    "test:integration": "npm run rebuild:node && vitest run tests/integration",
    "test:coverage": "npm run rebuild:node && vitest run --coverage",
    "test:perf": "npm run rebuild:node && vitest run tests/integration/library-performance.test.ts",
    "test:e2e": "npm run rebuild:electron && npm run build && playwright test",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "validate:heic": "node scripts/validate-heic-packaged.mjs",
    "screenshots:readme": "npm run package:unpacked && node scripts/capture-readme-screenshots.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "fetch:binaries": "node scripts/fetch-binaries.mjs",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "node scripts/rebuild-electron.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:file-size && npm run check:read-only && npm run depcruise && npm run knip",
    "check:full": "npm run check && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-virtual": "3.14.24",
    "better-sqlite3": "12.11.1",
    "electron-log": "5.4.4",
    "exiftool-vendored": "39.1.0",
    "heic-convert": "2.1.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "17.4.3",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "electron-vite": "3.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "knip": "5.88.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
